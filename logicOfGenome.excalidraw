      "updated": 1792234311970,
      "link": null,
      "locked": false,
      "text": "When the plant \"dies\" the seeds\ndrop down on the ground. But the\nseeds don't start to grow, until\nthey will on the ground",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "BqDyCKLarKaVxt-5Fq6IP",
      "originalText": "When the plant \"dies\" the seeds drop down on the ground. But the seeds don't start to grow, until they will on the ground",
      "autoResize": true,
      "lineHeight": 1.25
    },
