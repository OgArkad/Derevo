        }
      ],
      "updated": 1792234311970,
      "link": null,
      "locked": false,
      "text": "How to create the genome:\n-make a fixed length array of bits, that with a low chance will change after some time\n(pseudo code): byte[] ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How to create the genome:\n-make a fixed length array of bits, that with a low chance will change after some time\n(pseudo code): byte[] ",
      "autoResize": true,
      "lineHeight": 1.25
